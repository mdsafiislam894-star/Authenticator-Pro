{
  "manifest_version": 3,
  "name": "Authenticator Pro - 2FA & Smart Recovery Vault",
  "short_name": "Authenticator Pro",
  "version": "3.0.0",
  "description": "Ultra-luxury Liquid Glass 2FA Authenticator & Smart Recovery Codes Vault with instant autofill and cloud backup.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Authenticator Pro"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "sidePanel",
    "identity",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["js/content-autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://mdsafiislam894-star.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
